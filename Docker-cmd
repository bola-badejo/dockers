# Build an image
docker build -t <name>:<tag> .

# Build with a specific Dockerfile
docker build -f Dockerfile.prod -t <name>:<tag> .

# Build multi-stage up to a target
docker build --target build -t <name>:build .

# Run a container
docker run -d --name <container> -p 8080:8080 <name>:<tag>

# Run with env file
docker run -d --env-file .env -p 8080:8080 <name>:<tag>

# Logs, exec, stop, remove
