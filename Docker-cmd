# One-Command Shortcuts (Makefile)
# Save as Makefile at project root:


IMAGE ?= my-app
TAG   ?= latest
PORT  ?= 8080

build:
	docker build -t $(IMAGE):$(TAG) .

run:
	docker run -d --name $(IMAGE) --env-file .env -p $(PORT):$(PORT) $(IMAGE):$(TAG)

logs:
	docker logs -f $(IMAGE)

stop:
	docker stop $(IMAGE) && docker rm $(IMAGE)

push:
	docker tag $(IMAGE):$(TAG) youruser/$(IMAGE):$(TAG)
	docker push youruser/$(IMAGE):$(TAG)

rebuild: stop build run

up:
	docker compose up -d --build

down:
	docker compose down -v
  

